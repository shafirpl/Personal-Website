# Copy to .env and fill in. .env is git-ignored and loaded by `npm start` / `npm run dev`.

# SendGrid API key used to send contact-form emails (required for /api/email).
SENDGRID_API_KEY=

# Port the Express server listens on. Defaults to 80; use 5000 locally so the
# Vite dev server's /api proxy reaches it.
PORT=5000

# Optional overrides for the contact email addresses.
# MAIL_TO=shafi.rplwork@gmail.com
# MAIL_FROM=shafi.rplwork@gmail.com
